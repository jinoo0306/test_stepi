# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.polaris/

# 도구가 남기는 백업본 (.next.rootbak.NNN / next-env.d.ts.rootbak.NNN)
*.rootbak.*

# 에이전트 세션 상태
.omc/

# 지원자 데이터 — 원격이 PUBLIC 저장소라 한 번 올라가면 되돌리기 어렵다.
# 리포 루트 .gitignore 가 *.xlsx / *.pkl 을 잡아 주지만 csv·zip·json 은 안 걸린다.
*.xlsx
*.xls
*.csv
*.zip
*.pkl
attachments/
지원자데이터/
samples/

# 위 *.png 류 전역 규칙에 걸리지 않도록, 화면 자산은 예외로 둔다
!public/**

# 로컬 설정 예시는 남긴다 (필요한 env 키를 아무도 모르게 되는 것을 막는다)
!.env.example
